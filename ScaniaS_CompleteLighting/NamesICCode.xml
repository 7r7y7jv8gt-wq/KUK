<?xml version='1.0' encoding='UTF-8'?>
<namesICReference>
    <!-- Installed in the ZIP. Six newly authored replacement artwork textures are included. -->
    <design15Configurations title="Name layout">
        <design15Configuration name="J. Kristensen left / M. Kolbræk right" price="0" isDefault="true">
            <objectChange node="nameLayoutJKLeft" visibilityActive="true" visibilityInactive="false"/>
        </design15Configuration>
        <design15Configuration name="M. Kolbræk left / J. Kristensen right" price="0" isDefault="false">
            <objectChange node="nameLayoutMKLeft" visibilityActive="true" visibilityInactive="false"/>
        </design15Configuration>
    </design15Configurations>
    <interactiveControl>
        <interactiveControls>
            <outdoorTrigger linkNode="gv604Root" filename="SHARED_INTERACTIVE_TRIGGER" translation="0 0.3 0" width="3" height="2.5" length="3"/>
            <!-- 1: Native open/close control, saved and synchronized by IC. -->
            <interactiveControl posText="Close front sign" negText="Open front sign" allowsSaving="true">
                <clickPoint linkNode="gv604Root" translation="-0.38 0.10 0.08" type="OUTDOOR" iconType="CROSS" alignToCamera="true" size="0.04"/>
                <animation name="gv604Fold" speedScale="1" initTime="0"/>
            </interactiveControl>
            <!-- 2: State owner; no click action. Exactly 0 = heavy, 0.5 = long,
             1 = wide. The cycle button changes it with native IC state events. -->
            <interactiveControl analog="true" allowsSaving="true">
                <animation name="gv604Mode" initTime="0"/>
            </interactiveControl>
            <!-- 3: Momentary button; this function does not own persistent state. -->
            <interactiveControl posText="Next transport sign" negText="Next transport sign" allowsSaving="false">
                <clickPoint linkNode="gv604Root" translation="0.38 0.10 0.08" type="OUTDOOR" iconType="CROSS" alignToCamera="true" size="0.04"/>
                <dependingInteractiveControl index="1" minLimit="0.999" maxLimit="1"/>
                <function name="SCANIA_GV604_CYCLE_MODE"/>
            </interactiveControl>
        </interactiveControls>
    </interactiveControl>
    <animations>
        <animation name="gv604Fold">
            <part node="gv604LidHinge" startTime="0" endTime="0.65" startRot="180 0 0" endRot="0 0 0"/>
            <part node="gv604Locks" startTime="0" endTime="0.65" startRot="180 0 0" endRot="0 0 0"/>
            <part node="gv604Signs" startTime="0.55" endTime="0.65" startVisibility="false" endVisibility="true"/>
        </animation>
        <animation name="gv604Mode" resetOnStart="false">
            <part node="gv604Heavy" startTime="0" endTime="1" startVisibility="true" endVisibility="false"/>
            <part node="gv604Long" startTime="0" endTime="1" startVisibility="false" endVisibility="true"/>
            <part node="gv604Long" startTime="1" endTime="2" startVisibility="true" endVisibility="false"/>
            <part node="gv604Wide" startTime="1" endTime="2" startVisibility="false" endVisibility="true"/>
        </animation>
    </animations>
    <i3dMappings>
        <i3dMapping id="nameLayoutJKLeft" node="0&gt;0|8|15"/>
        <i3dMapping id="nameLayoutMKLeft" node="0&gt;0|8|14"/>
        <i3dMapping id="gv604Root" node="0&gt;0|8|13|0"/>
        <i3dMapping id="gv604Locks" node="0&gt;0|8|13|0|0"/>
        <i3dMapping id="gv604Signs" node="0&gt;0|8|13|0|1"/>
        <i3dMapping id="gv604Ad" node="0&gt;0|8|13|0|1|0"/>
        <i3dMapping id="gv604Heavy" node="0&gt;0|8|13|0|1|1"/>
        <i3dMapping id="gv604Long" node="0&gt;0|8|13|0|1|2"/>
        <i3dMapping id="gv604Wide" node="0&gt;0|8|13|0|1|3"/>
        <i3dMapping id="gv604LidHinge" node="0&gt;0|8|13|0|5"/>
        <i3dMapping id="gv604Lid" node="0&gt;0|8|13|0|5|0"/>
    </i3dMappings>
</namesICReference>
