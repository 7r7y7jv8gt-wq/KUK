      <Normalmap fileId="2" />
      <Glossmap fileId="3" />
      <CustomParameter name="beltClipOffsets" value="1 0 0 0" />
      <CustomParameter name="beltUVScale" value="1 18 0 4" />
    </Material>
    <Material name="winchChainDummy_mat" materialId="7" alphaBlending="true" customShaderId="6">
      <Emissivemap fileId="5" />
    </Material>
  </Materials>
  <Shapes externalShapesFile="chainMaterialHolder.i3d.shapes" />
  <Dynamics />
  <Scene>
    <TransformGroup name="winchChain" nodeId="12">
      <Shape shapeId="1" name="material" clipDistance="10" nodeId="13" materialIds="6" castsShadows="true" receiveShadows="true" />
      <Shape shapeId="2" name="dummyMaterial" clipDistance="10" nodeId="14" materialIds="7" castsShadows="true" receiveShadows="true" />
      <Shape shapeId="3" name="hook" nodeId="15" materialIds="5" castsShadows="true" receiveShadows="true">
        <TransformGroup name="sizeMarker" translation="0 0 0.971698" nodeId="16" />
