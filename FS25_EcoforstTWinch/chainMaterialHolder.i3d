<?xml version='1.0' encoding='utf-8'?>
<i3D xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="chainMaterialHolder.i3d" version="1.6" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="GIANTS Editor 64bit" version="9.0.6" />
  </Asset>
  <Files>
    <File fileId="6" filename="$data/shaders/glowShader.xml" />
    <File fileId="10" filename="$data/shaders/vehicleShader.xml" />
