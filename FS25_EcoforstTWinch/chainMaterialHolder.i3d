  <Materials>
    <Material name="tajfunEGV80_decal" materialId="5" customShaderId="10">
      <Texture fileId="7" />
      <Normalmap fileId="8" />
      <Glossmap fileId="9" />
      <CustomParameter name="scratches_dirt_snow_wetness" value="0 0 1 0" />
    </Material>
    <Material name="winchChain_mat" materialId="6" customShaderId="4">
