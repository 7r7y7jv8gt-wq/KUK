@echo off
setlocal
rem Downloads only this map draft from GitHub, verifies SHA256 and extracts into a new folder.
set "WALCHEN_TASK_DIR=%~dp0"
powershell.exe -NoProfile -Command "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue'; try { $mapTaskDir = $env:WALCHEN_TASK_DIR; $mapManifest = Get-Content -LiteralPath (Join-Path $mapTaskDir 'Walchen_BuildingsDraft_manifest.json') -Raw | ConvertFrom-Json; $mapOutputDir = Join-Path $mapTaskDir 'FS25_Walchen_2K20_BuildingsDraft'; if (Test-Path -LiteralPath $mapOutputDir) { throw 'Output folder already exists. Keep it and run this helper in a new empty folder.'; } $mapPartPaths = @(); foreach ($mapPart in $mapManifest.parts) { $mapPartPath = Join-Path $mapTaskDir $mapPart.name; if (Test-Path -LiteralPath $mapPartPath) { if ((Get-FileHash -LiteralPath $mapPartPath -Algorithm SHA256).Hash -ne $mapPart.sha256) { throw ('Existing part differs: ' + $mapPart.name + '. Keep it and use a new empty folder.'); } } else { Write-Host ('Downloading ' + $mapPart.name + '...'); Invoke-WebRequest -UseBasicParsing -Uri ('https://github.com/7r7y7jv8gt-wq/KUK/raw/fca3df9b77f9a85e9cb3264c47b3d42c1879b78a/' + $mapPart.name) -OutFile $mapPartPath; if ((Get-FileHash -LiteralPath $mapPartPath -Algorithm SHA256).Hash -ne $mapPart.sha256) { throw ('Checksum failed: ' + $mapPart.name + '. No extraction was performed.'); } } $mapPartPaths += $mapPartPath; } $mapArchivePath = Join-Path $mapTaskDir $mapManifest.archive_name; if (Test-Path -LiteralPath $mapArchivePath) { if ((Get-FileHash -LiteralPath $mapArchivePath -Algorithm SHA256).Hash -ne $mapManifest.archive_sha256) { throw 'Existing ZIP differs. Keep it and use a new empty folder.'; } } else { $mapOutputStream = [System.IO.File]::Open($mapArchivePath, [System.IO.FileMode]::CreateNew, [System.IO.FileAccess]::Write); try { foreach ($mapPartPath in $mapPartPaths) { $mapInputStream = [System.IO.File]::OpenRead($mapPartPath); try { $mapInputStream.CopyTo($mapOutputStream); } finally { $mapInputStream.Dispose(); } } } finally { $mapOutputStream.Dispose(); } } if ((Get-FileHash -LiteralPath $mapArchivePath -Algorithm SHA256).Hash -ne $mapManifest.archive_sha256) { throw 'Combined ZIP checksum failed. No extraction was performed.'; } Write-Host 'Archive verified. Extracting...'; Add-Type -AssemblyName System.IO.Compression.FileSystem; [System.IO.Compression.ZipFile]::ExtractToDirectory($mapArchivePath, $mapOutputDir); $mapScene = Join-Path $mapOutputDir 'map\map.i3d'; if (-not (Test-Path -LiteralPath $mapScene -PathType Leaf)) { throw 'Expected map/map.i3d not found.'; } Write-Host 'Finished. Open map.i3d in the displayed map folder with GIANTS Editor.'; Write-Host 'This is an unfinished building test; send a screenshot and editor_log.txt after opening.'; Invoke-Item -LiteralPath (Join-Path $mapOutputDir 'map'); } catch { Write-Host ('Could not finish: ' + $_.Exception.Message); exit 1; }"
pause
