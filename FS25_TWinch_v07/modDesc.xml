<?xml version='1.0' encoding='utf-8'?>
<modDesc descVersion="114">
  <author>Reference model project</author>
  <version>0.7.0.0</version>
  <title>
    <en>T-Winch v07 - Extended Blade Lowering</en>
  </title>
  <description>
    <en>V07 extends blade lowering by 25 degrees (about 34cm at the cutting edge). Engine on: left mouse vertical or Page Up/Page Down. Extended chrome rods and blade collision follow the new movement range.</en>
  </description>
  <iconFilename>icon_twinch.dds</iconFilename>
  <multiplayer supported="false" />
  <vehicleTypes>
    <type name="twinchV07" parent="baseDrivable" className="Vehicle" filename="$dataS/scripts/vehicles/Vehicle.lua">
      <specialization name="twinch" />
    </type>
  </vehicleTypes>
  <storeItems>
    <storeItem xmlFilename="twinch.xml" />
  </storeItems>
  <specializations>
    <specialization name="twinch" className="TWinch" filename="scripts/TWinch.lua" />
  </specializations>
  <actions>
    <action name="TWINCH_CONNECT" axisType="HALF" />
    <action name="TWINCH_REEL" axisType="HALF" />
    <action name="TWINCH_PAYOUT" axisType="HALF" />
    <action name="TWINCH_BLADE_LIFT" axisType="FULL" />
  </actions>
  <inputBinding>
    <actionBinding action="TWINCH_CONNECT">
      <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_b" />
    </actionBinding>
    <actionBinding action="TWINCH_REEL">
      <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_r" />
    </actionBinding>
    <actionBinding action="TWINCH_PAYOUT">
      <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_n" />
    </actionBinding>
    <actionBinding action="TWINCH_BLADE_LIFT">
      <binding device="KB_MOUSE_DEFAULT" input="MOUSE_BUTTON_LEFT AXIS_MOUSE_Y" axisComponent="+" inputComponent="+" />
      <binding device="KB_MOUSE_DEFAULT" input="MOUSE_BUTTON_LEFT AXIS_MOUSE_Y" axisComponent="-" inputComponent="-" />
      <binding device="KB_MOUSE_DEFAULT" input="KEY_pageup" axisComponent="+" inputComponent="+" />
      <binding device="KB_MOUSE_DEFAULT" input="KEY_pagedown" axisComponent="-" inputComponent="+" />
    </actionBinding>
  </inputBinding>
  <l10n>
    <text name="input_TWINCH_CONNECT">
      <en>T-Winch: attach / release vehicle</en>
    </text>
    <text name="input_TWINCH_REEL">
      <en>T-Winch: reel in on / off</en>
    </text>
    <text name="input_TWINCH_PAYOUT">
      <en>T-Winch: pay out on / off</en>
    </text>
    <text name="input_TWINCH_BLADE_LIFT">
      <en>Hydraulic blade (mouse / Page Up / Page Down)</en>
    </text>
    <text name="input_TWINCH_BLADE_LIFT_1">
      <en>Raise hydraulic blade</en>
    </text>
    <text name="input_TWINCH_BLADE_LIFT_2">
      <en>Lower hydraulic blade</en>
    </text>
  </l10n>
</modDesc>