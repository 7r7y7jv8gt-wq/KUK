<?xml version='1.0' encoding='utf-8'?>
<modDesc descVersion="114">
  <author>Reference model project</author>
  <version>0.10.0.0</version>
  <title>
    <en>T-Winch v10 - Hook Scale and Engelsen TerraFarm</en>
  </title>
  <description>
    <en>Protected small winch hooks with independent pose pivots. Engelsen Anlegg TerraFarm dozer profile adapted to the moving blade edge, 2.23m width. V09 crawler drivetrain and controls retained.</en>
  </description>
  <iconFilename>icon_twinch.dds</iconFilename>
  <multiplayer supported="false" />
  <vehicleTypes>
    <type name="twinchV10" parent="baseDrivable" className="Vehicle" filename="$dataS/scripts/vehicles/Vehicle.lua">
      <specialization name="twinch" />
      <specialization name="bunkerSiloInteractor" />
      <specialization name="leveler" />
    </type>
  </vehicleTypes>
  <storeItems>
    <storeItem xmlFilename="twinch.xml" />
  </storeItems>
  <specializations>
    <specialization name="twinch" className="TWinch" filename="scripts/TWinch.lua" />
  </specializations>
  <actions>
    <action name="TWINCH_CONNECT" axisType="HALF" />
    <action name="TWINCH_REEL" axisType="HALF" />
    <action name="TWINCH_PAYOUT" axisType="HALF" />
    <action name="TWINCH_BLADE_LIFT" axisType="FULL" />
    <action name="TWINCH_HOOK" axisType="HALF" />
    <action name="TWINCH_LOG_REEL" axisType="HALF" />
    <action name="TWINCH_LOG_FAST" axisType="HALF" />
    <action name="TWINCH_LOG_OUT" axisType="HALF" />
    <action name="TWINCH_LOG_CLEAR" axisType="HALF" />
  </actions>
  <inputBinding>
    <actionBinding action="TWINCH_CONNECT">
      <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_b" />
    </actionBinding>
    <actionBinding action="TWINCH_REEL">
      <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_r" />
    </actionBinding>
    <actionBinding action="TWINCH_PAYOUT">
      <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_n" />
    </actionBinding>
    <actionBinding action="TWINCH_BLADE_LIFT">
      <binding device="KB_MOUSE_DEFAULT" input="MOUSE_BUTTON_LEFT AXIS_MOUSE_Y" axisComponent="+" inputComponent="+" />
      <binding device="KB_MOUSE_DEFAULT" input="MOUSE_BUTTON_LEFT AXIS_MOUSE_Y" axisComponent="-" inputComponent="-" />
      <binding device="KB_MOUSE_DEFAULT" input="KEY_pageup" axisComponent="+" inputComponent="+" />
      <binding device="KB_MOUSE_DEFAULT" input="KEY_pagedown" axisComponent="-" inputComponent="+" />
    </actionBinding>
    <actionBinding action="TWINCH_HOOK">
      <binding device="KB_MOUSE_DEFAULT" input="KEY_r" />
    </actionBinding>
    <actionBinding action="TWINCH_LOG_REEL">
      <binding device="KB_MOUSE_DEFAULT" input="KEY_z" />
    </actionBinding>
    <actionBinding action="TWINCH_LOG_FAST">
      <binding device="KB_MOUSE_DEFAULT" input="KEY_lshift KEY_z" />
    </actionBinding>
    <actionBinding action="TWINCH_LOG_OUT">
      <binding device="KB_MOUSE_DEFAULT" input="KEY_x" />
    </actionBinding>
    <actionBinding action="TWINCH_LOG_CLEAR">
      <binding device="KB_MOUSE_DEFAULT" input="KEY_lshift KEY_r" />
    </actionBinding>
  </inputBinding>
  <l10n>
    <text name="input_TWINCH_CONNECT">
      <en>T-Winch: attach / release vehicle</en>
    </text>
    <text name="input_TWINCH_REEL">
      <en>T-Winch: reel in on / off</en>
    </text>
    <text name="input_TWINCH_PAYOUT">
      <en>T-Winch: pay out on / off</en>
    </text>
    <text name="input_TWINCH_BLADE_LIFT">
      <en>Hydraulic blade (mouse / Page Up / Page Down)</en>
    </text>
    <text name="input_TWINCH_BLADE_LIFT_1">
      <en>Raise hydraulic blade</en>
    </text>
    <text name="input_TWINCH_BLADE_LIFT_2">
      <en>Lower hydraulic blade</en>
    </text>
    <text name="input_TWINCH_HOOK">
      <en>Take / attach winch hook</en>
    </text>
    <text name="input_TWINCH_LOG_REEL">
      <en>Winch: hold to reel</en>
    </text>
    <text name="input_TWINCH_LOG_FAST">
      <en>Winch: hold to reel fast</en>
    </text>
    <text name="input_TWINCH_LOG_OUT">
      <en>Winch: hold to pay out</en>
    </text>
    <text name="input_TWINCH_LOG_CLEAR">
      <en>Winch: release all / return hook</en>
    </text>
  </l10n>
</modDesc>